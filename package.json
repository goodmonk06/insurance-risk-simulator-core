{
  "name": "insurance-risk-simulator-core",
  "version": "1.0.0",
  "description": "介護・医療領域のリスクシミュレータ",
  "main": "dist/index.js",
  "bin": {
    "risk-sim": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:cli": "ts-node src/cli.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:cli": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "insurance",
    "risk",
    "simulator",
    "actuarial"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.8.1",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  },
  "dependencies": {
    "@prisma/client": "^5.8.1",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.22.4"
  }
}
